grammar TomlRB::Document
  include TomlRB::Primitive

  rule document
    (comment | table_array | table | keyvalue_line | line_break | trailing_space)*
  end

  rule table_array
    (space? '[[' stripped_key ']]' line_end) <TomlRB::TableArrayParser>
  end

  rule table
    (space? '[' stripped_key ']' line_end) <TomlRB::TableParser>
  end

  rule keyvalue_line
    (stripped_key '=' space? v:(toml_values) line_end) <TomlRB::KeyvalueParser>
  end

  rule keyvalue
    (stripped_key '=' space? v:(toml_values) comment? space) <TomlRB::KeyvalueParser>
  end

  ### Values

  rule inline_table
    (space? '{' array_comments (keyvalue (array_comments ',' array_comments keyvalue)* (array_comments ',')?)? array_comments '}' ) <TomlRB::InlineTableParser>
  end

  rule array
    ("[" array_comments (array_elements (array_comments ",")?)? array_comments "]") <TomlRB::ArrayParser>
  end

  rule array_array
    (array (space "," array_comments array)*) {
      captures[:array].map(&:value)
    }
  end

  rule array_elements
    (toml_values (array_comments "," array_comments toml_values)*) {
      captures[:toml_values].map(&:value).map do |v|
        v.respond_to?(:value) ? v.value : v
      end
    }
  end

  ### Helpers

  rule line_end
    comment | line_break | space !.
  end

  rule trailing_space
    ([ \t]+ !.) { nil }
  end

  rule stripped_key
    (space? key space?) { captures[:key].first.value }
  end

  rule array_comments
    (indent? (comment indent?)*)
  end

  rule toml_values
    primitive | inline_table | array
  end
end
